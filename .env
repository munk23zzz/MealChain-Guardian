# ============================================================
# MealChain Guardian — environment template (S0-08)
# SALIN jadi .env lalu isi nilai lokal. JANGAN pernah commit .env.
# Semua nilai di file ini adalah placeholder, BUKAN kredensial asli.
# ============================================================

# Database
# Host port 15432 (bukan 5432): port 5432 host sudah dipakai postgres proyek lain
POSTGRES_USER=mealchain
POSTGRES_PASSWORD=mealchain_local
POSTGRES_DB=mealchain
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://mealchain:mealchain_local@postgres:5432/mealchain

# Auth (dipakai Sprint 2)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# AWS — isi oleh Roy di luar agent/chat (Rules.md §7)
AWS_REGION=us-west-2
SUPERVISOR_MODEL_PRIMARY=sap-ai-core:llm
# (slot legacy diabaikan bila slot bernomor ada — lihat model_registry)
# Setelah model access Anthropic diaktifkan di console, ganti primary ke Claude
# terbaru: us.anthropic.claude-sonnet-5 (lihat docs/verification/sprint-0.md)
AGENTCORE_RUNTIME_ARN=
AGENTCORE_GATEWAY_URL=

# SAP AI Core — diisi setelah akses dari panitia dikonfirmasi
# COMPOSE MENGHARUSKAN ESCAPE: karakter `$` di nilai WAJIB ditulis `$$`.
# Interpolasi docker compose memotong nilai setelah `$` (terukur: 81 -> 37 char),
# sehingga OAuth SAP AI Core gagal walau berkasnya benar. Pembaca host yang membaca
# .env mentah harus mengembalikan `$$` menjadi `$` lebih dulu.
SAP_AI_CORE_AUTH_URL=https://aws-sap-hackathon-si4ykj9d.authentication.ap10.hana.ondemand.com
SAP_AI_CORE_API_URL=https://api.ai.prod.ap-southeast-2.aws.ml.hana.ondemand.com
SAP_AI_CORE_CLIENT_ID=sb-949c5904-cced-43f2-9d54-d7d672248966!b111833|aicore!b1456
SAP_AI_CORE_CLIENT_SECRET=d3c017d2-fcc1-47ce-ac36-2cf8a55c9766$$WgQqGblVK81kT5vpZD6Pklc1tf72HkYkJZ59XK4638c=
# S4-10: id deployment NYATA di resource-group `default` (probe 2026-10-11).
SAP_AI_CORE_RESOURCE_GROUP=default
SAP_AI_CORE_DEPLOYMENT_ID_LLM=dc9594f579d3e4c1
SAP_AI_CORE_DEPLOYMENT_ID_RPT=d76cf689a05d504f
VERIFIER_MODEL_PRIMARY=sap-ai-core:llm
VERIFIER_MODEL_FALLBACK_1=cb/gpt-6-astra
VERIFIER_MODEL_FALLBACK_2=cx/gpt-6-astra
FORECAST_MODEL=sap-ai-core:rpt

# SAP data provider mode — default mock semua kapabilitas (Architecture.md §9.2)
SAP_MATERIAL_STOCK_MODE=mock
SAP_PURCHASE_ORDER_MODE=mock
SAP_MATERIAL_DOCUMENT_MODE=mock
SAP_BUSINESS_PARTNER_MODE=mock
SAP_PRODUCT_MASTER_MODE=mock

# Aplikasi — DEMO_MODE WAJIB false di luar sesi demo (Rules.md §1.4)
DEMO_MODE=False
DEBUG=false
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_PORT=8000
# Frontend di 3010, BUKAN 3000: port 3000 ditempati dev server aplikasi acuan
# (E:\hackathon\HackathonBil\MealchainGuardian) di mesin demo. Konsol aktif
# selalu diakses di http://localhost:3010 (semua skrip verifikasi memakai ini).
FRONTEND_PORT=3010
MOCK_SAP_PORT=8001

# IAM credentials (S0-05 AgentCore + Service Quotas)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SUPERVISOR_MODEL_FALLBACK_2=cx/gpt-6-astra
SUPERVISOR_MODEL_FALLBACK_3=cb/gpt-6-sol

