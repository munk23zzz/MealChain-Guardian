{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GatewayLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-west-2:${AWS_ACCOUNT_ID}:log-group:/aws/bedrock-agentcore/*"
    }
  ]
}
