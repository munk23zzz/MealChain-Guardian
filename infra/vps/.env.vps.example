# =============================================================================
# MealChain Guardian — templat .env untuk stack VPS (infra/vps/docker-compose.vps.yml)
# =============================================================================
#
# SALIN lalu isi:
#     cp infra/vps/.env.vps.example infra/vps/.env
#     chmod 600 infra/vps/.env
#
# Berkas `.env` (nama persis itu) SUDAH di-.gitignore — jangan pernah
# memindahkannya ke nama lain, dan jangan pernah commit isinya.
#
# Semua nilai di bawah adalah PLACEHOLDER. Yang ditandai [WAJIB DIGANTI] akan
# membuat `deploy.sh` berhenti bila masih apa adanya.
# =============================================================================

# -----------------------------------------------------------------------------
# Identitas deployment
# -----------------------------------------------------------------------------
# Domain utama (UI). Tanpa "https://", tanpa garis miring di akhir.
# DNS: A record <DOMAIN> dan api.<DOMAIN> → IP VPS.
DOMAIN=demo.example.com

# Email untuk pendaftaran sertifikat Let's Encrypt (notifikasi masa berlaku).
ACME_EMAIL=admin@example.com

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
POSTGRES_USER=mealchain

# [WAJIB DIGANTI] Sandi DB. Buat dengan acak, jangan diketik manual:
#     openssl rand -hex 24
POSTGRES_PASSWORD=GANTI_openssl_rand_hex_24

POSTGRES_DB=mealchain

# DSN lengkap untuk alat lokal (psql, migrasi manual dari mesin sendiri).
# CATATAN PENTING: kontainer backend TIDAK memakai baris ini — compose
# menurunkan DATABASE_URL dari POSTGRES_USER/PASSWORD/DB di atas supaya DSN dan
# sandi tidak mungkin berbeda. Baris ini disediakan untuk dokumentasi/alat.
DATABASE_URL=postgresql+asyncpg://mealchain:GANTI_openssl_rand_hex_24@postgres:5432/mealchain

# -----------------------------------------------------------------------------
# Keamanan aplikasi (backend)
# -----------------------------------------------------------------------------
# [WAJIB DIGANTI] Kunci tanda tangan JWT. Buat dengan:
#     openssl rand -hex 32
# Mengganti nilai ini = SEMUA sesi login lama tidak berlaku (lihat README:
# "Rotasi JWT_SECRET"). Jangan pakai nilai contoh di bawah.
JWT_SECRET=GANTI_openssl_rand_hex_32

JWT_ALGORITHM=HS256

# Masa berlaku token. 480 menit (8 jam) supaya sesi juri tidak habis di tengah
# demo; naikkan/turunkan sesuai kebutuhan.
JWT_EXPIRE_MINUTES=480

# Origin browser yang boleh memanggil API (CORS). UI memanggil
# https://api.<DOMAIN> dari origin https://<DOMAIN>, jadi origin UI WAJIB ada.
# Biarkan KOSONG = otomatis "https://$DOMAIN" (disarankan, tidak bisa salah
# ketik). Isi manual hanya bila ada origin tambahan, dipisah koma.
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Mode demo
# -----------------------------------------------------------------------------
# true = akun demo (sppg.head@demo.local dkk) boleh dipakai dan data demo
# disemai. Untuk VPS demo/juri. JANGAN true pada instalasi yang memuat data
# sungguhan.
DEMO_MODE=true

# Isi otomatis sandi di layar login. Biarkan false: sandi demo bisa dibaca
# siapa pun yang menjangkau endpoint ini. Kalau dinyalakan, DEMO_LOGIN_ALLOW_REMOTE
# juga harus true saat di belakang reverse proxy.
DEMO_LOGIN_AUTOFILL=true

# Endpoint /auth/demo-login hanya melayani pemanggil lokal kecuali flag ini true.
# Di belakang Caddy semua permintaan datang dari IP kontainer Caddy, jadi
# autofill TIDAK akan bekerja tanpa flag ini.
DEMO_LOGIN_ALLOW_REMOTE=false

# false = tombol mutasi tidak menolak 409 saat sesi demo kedaluwarsa. Pilihan
# untuk VPS juri: satu sesi kedaluwarsa tidak boleh membuat demo buntu.
DEMO_SESSION_ENFORCE=false

# -----------------------------------------------------------------------------
# Backend — operasional
# -----------------------------------------------------------------------------
DEBUG=false
ENABLE_DOCS=false

# Pembatas login per-IP (dipakai backend; Caddy hanya meneruskan IP asli).
LOGIN_RATE_LIMIT=10
LOGIN_RATE_WINDOW=60

# CIDR proxy yang dipercaya membaca X-Forwarded-For. 172.16.0.0/12 = jaringan
# docker bridge. Jangan "*" di mesin yang port backend-nya bisa dijangkau
# langsung dari luar.
FORWARDED_ALLOW_IPS=172.16.0.0/12

# Worker agent: "off" = deterministik penuh (tanpa model LLM). Mode demo
# "full LLM" memakai "advisory" + model di bawah terisi; bila kredensial model
# kosong, agen akan lapor degraded (jujur), bukan mengarang.
WORKER_AGENT_MODE=advisory
MULTI_AGENT_REVIEW=true
AGENT_REVIEW_MODE=local

# Kunci tanda tangan dossier (ECDSA secp256k1, hex). Kosong = status "unsigned"
# yang jujur, bukan tanda tangan palsu. Isi hanya bila Anda memegang kuncinya.
SIGNING_KEY_HEX=

# -----------------------------------------------------------------------------
# SAP — mode mock (default VPS demo)
# -----------------------------------------------------------------------------
SAP_PROVIDER=mock
SAP_MATERIAL_STOCK_MODE=mock
SAP_PURCHASE_ORDER_MODE=mock
SAP_MATERIAL_DOCUMENT_MODE=mock
SAP_BUSINESS_PARTNER_MODE=mock
SAP_PRODUCT_MASTER_MODE=mock

# Kontrak asli SAP (AI Core / MCP) — biarkan kosong untuk demo. Bila diisi,
# JANGAN pakai kunci akun AWS asli di berkas ini (lihat SECURITY.md).
# SAP_AI_CORE_API_URL=
# SAP_AI_CORE_AUTH_URL=
# SAP_AI_CORE_CLIENT_ID=
# SAP_AI_CORE_CLIENT_SECRET=
# SAP_AI_CORE_RESOURCE_GROUP=
# SAP_AI_CORE_DEPLOYMENT_ID_LLM=
# SAP_AI_CORE_DEPLOYMENT_ID_RPT=
# SAP_MCP_ENDPOINT=
# SAP_MCP_TOKEN=

# -----------------------------------------------------------------------------
# Frontend (Next.js)
# -----------------------------------------------------------------------------
# Di-INLINE saat build. Kosong = otomatis "https://api.$DOMAIN".
# Isi manual hanya bila API berada di host lain (mis. https://api.contoh.id).
NEXT_PUBLIC_API_URL=

# false = UI memakai API sungguhan (bukan fixture statis GitHub Pages).
NEXT_PUBLIC_USE_MOCK=false

# Base path. Kosong = UI di akar domain.
NEXT_PUBLIC_BASE_PATH=

# -----------------------------------------------------------------------------
# Caddy (batas ukuran body)
# -----------------------------------------------------------------------------
MAX_BODY_API=10MB
MAX_BODY_FRONTEND=2MB
