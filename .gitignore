# Environment files
# .env = nilai nyata (lokal saja, tidak pernah di-commit — Rules.md §7).
# .env.example WAJIB ikut ter-commit: templat untuk teman/Kiro tanpa nilai asli.
.env
.env.local
.env.*.local
# Salinan/backup .env memuat rahasia nyata (mis. .env.bak-gateway).
.env.bak*
.env.backup*
!.env.example

# Scratch diagnosa AWS (dulu ikut ter-commit tanpa sengaja)
/_diag.py
/diag_*.py
/*.stackdump
/_iam_policy_*.json
/_role_arn.txt

# Ekspor dump database — memuat hash kata sandi pengguna demo; regenerasi lokal
# lewat `pg_dump` bila perlu, jangan dibagikan lewat git.
/data/export/
# Checkpoint anchor ledger (Fase 11 butir 2): dibuat lokal oleh
# `scripts/ledger_anchor.py`, isinya keadaan mesin ini — bukan artefak untuk git.
/data/anchors/
# Bukti audit DB (dump penuh 1,3 MB + hash kata sandi) — regenerasi lokal dengan
# `verify/audit-db/run_checks.py`, bukan artefak untuk git.
/verify/audit-db/

