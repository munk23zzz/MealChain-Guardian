dist/
*.egg

# SDD scratch workspace (subagent-driven-development)
.superpowers/

# Kredensial lokal (access key AWS) — JANGAN pernah di-commit
secrets/

# sap-joule (jembatan A2A Joule): kredensial lokal TIDAK pernah di-commit
sap-joule/*-key.json
sap-joule/group.json
sap-joule/keybroker-credentials.txt
sap-joule/*.env
sap-joule/**/.venv/
