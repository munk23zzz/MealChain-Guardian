__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
.venv/
venv/
ENV/
env/
.eggs/
*.egg-info/
*.egg

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Next.js
.next/
out/
build/
# Artefak increment build TypeScript (`tsc --incremental`) — bukan sumber.
*.tsbuildinfo

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Linting
.ruff_cache/
.mypy_cache/

# IDEs
.idea/
.vscode/
*.swp
*.swo
*~

# Environment files
# .env = nilai nyata (lokal saja, tidak pernah di-commit — Rules.md §7).
# .env.example WAJIB ikut ter-commit: templat untuk teman/Kiro tanpa nilai asli.
.env
.env.local
.env.*.local
!.env.example

# Scratch diagnosa AWS (dulu ikut ter-commit tanpa sengaja)
/_diag.py
/diag_*.py
/*.stackdump
/_iam_policy_*.json
/_role_arn.txt

# Ekspor dump database — memuat hash kata sandi pengguna demo; regenerasi lokal
# lewat `pg_dump` bila perlu, jangan dibagikan lewat git.
/data/export/

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Build artifacts
dist/
*.egg

# SDD scratch workspace (subagent-driven-development)
.superpowers/

# Kredensial lokal (access key AWS) — JANGAN pernah di-commit
secrets/

# sap-joule (jembatan A2A Joule): kredensial lokal TIDAK pernah di-commit
sap-joule/*-key.json
sap-joule/group.json
sap-joule/keybroker-credentials.txt
sap-joule/*.env
sap-joule/**/.venv/
sap-joule/**/.pytest_cache/
