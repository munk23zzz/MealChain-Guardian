# Database Configuration
POSTGRES_USER=mealchain
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=mealchain
POSTGRES_PORT=5432

# Database URL (async driver)
DATABASE_URL=postgresql+asyncpg://mealchain:password@localhost:5432/mealchain

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# AWS Configuration
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# AWS Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# AgentCore Configuration
AGENTCORE_RUNTIME_ARN=your_agentcore_runtime_arn_here
AGENTCORE_GATEWAY_URL=your_agentcore_gateway_url_here

# SAP Configuration
SAP_MODE=mock
MOCK_SAP_KEY=not-a-real-key

# Application Configuration
DEBUG=true
APP_NAME=MealChain Guardian
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_PORT=8000
FRONTEND_PORT=3000
