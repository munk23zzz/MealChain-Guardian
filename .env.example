# =============================================================================
# MealChain Guardian — TEMPLATE lingkungan (.env.example)
# =============================================================================
# Rules.md §7: TIDAK ada secret di repo; berkas ini tidak boleh memuat nilai
# asli. Salin jadi .env (`cp .env.example .env`) lalu isi nilai nyata —
# .env sudah diabaikan git.
#
# PENTING soal tanda kutip: nilai yang memuat `$` atau `|` WAJIB dibungkus
# kutip tunggal di .env, kalau tidak shell/Compose memotong nilainya
# (terukur: SAP_AI_CORE_CLIENT_SECRET 81 → 37 karakter).
# =============================================================================

# --- Database lokal (Compose) -------------------------------------------------
POSTGRES_USER=mealchain
POSTGRES_PASSWORD=ganti-di-lokal
POSTGRES_DB=mealchain
# Port host 15432: 5432 di host sering sudah dipakai postgres proyek lain
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://mealchain:ganti-di-lokal@postgres:5432/mealchain

# --- Auth (JWT) ---------------------------------------------------------------
# Wajib: backend membalas 503 kalau kosong. Pakai hasil `openssl rand -hex 32`.
JWT_SECRET=ganti-dengan-64-karakter-hex-acak
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- CORS ---------------------------------------------------------------------
# Kosongkan untuk memakai bawaan (localhost:3000 dan localhost:3010, lihat
# backend/app/main.py::_cors_origins). Isi hanya kalau UI diakses dari origin
# lain, mis. https://<codespace>-3010.app.github.dev — daftar dipisah koma.
CORS_ORIGINS=

# --- Port host (Compose) ------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3010
MOCK_SAP_PORT=8001
# Kosong = UI memakai path relatif + proxy Next (next.config.js). Isi absolut
# (mis. http://localhost:8000) untuk memanggil backend lintas origin langsung.
NEXT_PUBLIC_API_URL=

# --- Mode demo ----------------------------------------------------------------
DEMO_MODE=false
DEBUG=false

# --- Review 7 worker agent (P0: default MATI) ----------------------------------
# false = perilaku lama: 1 supervisor + 4 tool baca. Jangan nyalakan sebelum
# kontrak P1-P3 selesai. `advisory` = agen hanya meninjau keputusan deterministik.
MULTI_AGENT_REVIEW=false
AGENT_REVIEW_MODE=advisory
AGENT_REVIEW_TIMEOUT_SECONDS=75

# --- SAP (mock / integrasi) ---------------------------------------------------
# mock = layanan tiruan di dalam repo; aws_mcp = jalur AWS for SAP (Sprint 5).
SAP_MATERIAL_STOCK_MODE=mock
SAP_PURCHASE_ORDER_MODE=mock
SAP_MATERIAL_DOCUMENT_MODE=mock
SAP_BUSINESS_PARTNER_MODE=mock
SAP_PRODUCT_MASTER_MODE=mock

# --- SAP AI Core (kredensial dari panitia / keybroker) ------------------------
# Nilai asli HANYA di .env lokal. Urutan penamaan: SAP_AI_CORE_* (dipakai
# backend) — jangan tertukar dengan AICORE_* yang dipakai skrip probe.
SAP_AI_CORE_AUTH_URL=https://contoh.authentication.ap10.hana.ondemand.com
SAP_AI_CORE_API_URL=https://contoh.ap10.sapdas.cloud.sap
SAP_AI_CORE_CLIENT_ID=sb-contoh!t000000
SAP_AI_CORE_CLIENT_SECRET='contoh-rahasia-dengan-$-dan-|'
SAP_AI_CORE_RESOURCE_GROUP=default
SAP_AI_CORE_DEPLOYMENT_ID_LLM=0000000000000000
SAP_AI_CORE_DEPLOYMENT_ID_RPT=0000000000000000

# --- AWS (Bedrock / AgentCore) ------------------------------------------------
AWS_REGION=ap-southeast-2
AWS_PROFILE=
# Kunci asli jangan di berkas ini: taruh di secrets/aws-app.env (diabaikan git)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AGENTCORE_RUNTIME_ARN=
AGENTCORE_GATEWAY_URL=
AGENTCORE_MEMORY_ID=

# --- Inferhub (fallback model) ------------------------------------------------
INFERHUB_URL=
INFERHUB_API_KEY=

# --- Rantai model (nama model, bukan rahasia) ---------------------------------
SUPERVISOR_MODEL_PRIMARY=us.anthropic.claude-sonnet-5
SUPERVISOR_MODEL_FALLBACK=
SUPERVISOR_MODEL_FALLBACK_1=
SUPERVISOR_MODEL_FALLBACK_2=
SUPERVISOR_MODEL_FALLBACK_3=
SUPERVISOR_MODEL_FALLBACK_4=
SUPERVISOR_MODEL_FALLBACK_5=
SUPERVISOR_MODEL_FALLBACK_6=
SUPERVISOR_MODEL_FALLBACK_7=
SUPERVISOR_MODEL_FALLBACK_8=
SUPERVISOR_MODEL_FALLBACK_9=
SUPERVISOR_MODEL_FALLBACK_10=
SUPERVISOR_MODEL_FALLBACK_11=

VERIFIER_MODEL_PRIMARY=
VERIFIER_MODEL_FALLBACK_1=
VERIFIER_MODEL_FALLBACK_2=
VERIFIER_MODEL_FALLBACK_3=
VERIFIER_MODEL_FALLBACK_4=
VERIFIER_MODEL_FALLBACK_5=
VERIFIER_MODEL_FALLBACK_6=
VERIFIER_MODEL_FALLBACK_7=
VERIFIER_MODEL_FALLBACK_8=
VERIFIER_MODEL_FALLBACK_9=
VERIFIER_MODEL_FALLBACK_10=

FORECAST_MODEL=
FORECAST_MODEL_FALLBACK_1=
FORECAST_MODEL_FALLBACK_2=
FORECAST_MODEL_FALLBACK_3=
FORECAST_MODEL_FALLBACK_4=
FORECAST_MODEL_FALLBACK_5=
FORECAST_MODEL_FALLBACK_6=
FORECAST_MODEL_FALLBACK_7=
FORECAST_MODEL_FALLBACK_8=
FORECAST_MODEL_FALLBACK_9=
FORECAST_MODEL_FALLBACK_10=

# --- Integritas (P3): tanda tangan ECDSA dossier -------------------------------
# 64 hex = kunci privat secp256k1. Kosong = state `unsigned` (jujur, bukan ttd
# palsu). Buat baru: `openssl rand -hex 32`.
SIGNING_KEY_HEX=
