# =============================================================================
# MealChain Guardian — TEMPLATE lingkungan (.env.example)
# =============================================================================
# Rules.md §7: TIDAK ada secret di repo; berkas ini tidak boleh memuat nilai
# asli. Salin jadi .env (`cp .env.example .env`) lalu isi nilai nyata —
# .env sudah diabaikan git.
#
# PENTING soal tanda kutip: nilai yang memuat `$` atau `|` WAJIB dibungkus
# kutip tunggal di .env, kalau tidak shell/Compose memotong nilainya
# (terukur: SAP_AI_CORE_CLIENT_SECRET 81 → 37 karakter).
# =============================================================================

# --- Database lokal (Compose) -------------------------------------------------
POSTGRES_USER=mealchain
POSTGRES_PASSWORD=ganti-di-lokal
POSTGRES_DB=mealchain
# Port host 15432: 5432 di host sering sudah dipakai postgres proyek lain
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://mealchain:ganti-di-lokal@postgres:5432/mealchain

# --- Auth (JWT) ---------------------------------------------------------------
# Wajib: backend membalas 503 kalau kosong. Pakai hasil `openssl rand -hex 32`.
JWT_SECRET=ganti-dengan-64-karakter-hex-acak
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=30

# --- CORS ---------------------------------------------------------------------
# Kosongkan untuk memakai bawaan (localhost:3000 dan localhost:3010, lihat
# backend/app/main.py::_cors_origins). Isi hanya kalau UI diakses dari origin
# lain, mis. https://<codespace>-3010.app.github.dev — daftar dipisah koma.
CORS_ORIGINS=

# --- Port host (Compose) ------------------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=3010
MOCK_SAP_PORT=8001
# Kosong = UI memakai path relatif + proxy Next (next.config.js). Isi absolut
# (mis. http://localhost:8000) untuk memanggil backend lintas origin langsung.
NEXT_PUBLIC_API_URL=

# --- Mode database (DEFAULT / DEMO) -------------------------------------------
# Menentukan isi database yang DIHARAPKAN, bukan cara aplikasi membaca data.
#   default = schema + referensi saja (komoditas, lokasi/SPPG, akun RBAC)
#   demo    = default + seluruh dataset demo (deret waktu, kasus, pelengkap)
# Perintah penyiapnya (lihat .claude/skills/db-mode/SKILL.md):
#   bash scripts/db-mode.sh status
#   DB_MODE=default bash scripts/db-mode.sh init-default
#   DB_MODE=demo    bash scripts/db-mode.sh init-demo
#   DB_MODE=default bash scripts/db-mode.sh reset-demo --yes
DB_MODE=default

# --- Mode demo ----------------------------------------------------------------
DEMO_MODE=false
# Autofill sandi di layar login (OPSIONAL, default mati). Hanya berpengaruh bila
# DEMO_MODE juga aktif. Saat true, `GET /auth/demo-login` mengirim email + sandi
# akun demo ke browser sehingga satu klik peran langsung siap masuk.
# JANGAN nyalakan pada instalasi yang bisa diakses publik.
DEMO_LOGIN_AUTOFILL=false
# Tujuh worker agent (27 Okt 2026). `off` = pemeriksa deterministik murni.
# `advisory` = model ikut menalar untuk memperkaya ringkasan; status, blokir,
# dan sitasi TETAP milik pemeriksa deterministik, dan model tidak boleh
# menambah angka di luar fakta.
WORKER_AGENT_MODE=off
# Model untuk 7 worker saja. Supervisor memakai SUPERVISOR_MODEL_PRIMARY;
# verifier memakai VERIFIER_AGENT_MODEL. TIDAK ada cadangan lintas agent —
# verifier harus tetap independen dari model supervisor.
WORKER_AGENT_MODEL=
# Sesi demo (migrasi 024): default kosong + data hidup selama sesi.
# Biarkan false sampai UI Demo Control punya tombol "Siapkan data demo" —
# bila true tanpa sesi, seluruh data operasional memang sengaja kosong.
DEMO_SESSION_ENFORCE=false
DEMO_SESSION_MINUTES=120
DEMO_SESSION_MAX_MINUTES=240
# Riwayat fakta yang disemai saat sesi dimulai. 30 = pemilih periode KPI
# (24 jam / 7 hari / 30 hari) punya pembeda; 0 = hanya data hari ini (start cepat).
DEMO_SESSION_HISTORY_DAYS=30
DEBUG=false

# Dokumentasi API (/docs, /redoc, /openapi.json). Default TERTUTUP (SEC-04);
# buka hanya saat mengembangkan. DEBUG=true juga membukanya.
ENABLE_DOCS=false

# Pembatas login (SEC-03): percobaan gagal per IP+email dalam satu jendela.
LOGIN_RATE_LIMIT=20
LOGIN_RATE_WINDOW=60

# --- Review 7 worker agent (P5: orkestrasi + panel Agent Log) ------------------
# Kontrak default: MATI. Nyalakan hanya untuk demo.
# true  = setiap keputusan baru menjalankan review 8 agen di AgentCore Runtime dan
#         menyimpan 9 baris trace (7 worker + verifier + SUPERVISE). Panel Agent Log
#         menampilkan delapan kartu.
# false = panel Agent Log hanya menampilkan langkah event demo (tanpa review agen).
# Butuh AGENTCORE_RUNTIME_ARN terisi + kredensial AWS di secrets/aws-app.env
# (kecuali AGENT_REVIEW_MODE=local, lihat di bawah).
MULTI_AGENT_REVIEW=false
# Tempat review berjalan:
# advisory / predecision / agentcore / kosong = runtime AgentCore (perilaku lama,
#         default AMAN: tidak ada yang berpindah jalur tanpa keputusan operator)
# local  = orkestrator IN-PROSES dari repo ini (agent/orchestrator.py). Dipakai
#         saat image runtime yang ter-deploy bisa tertinggal dari repo: kode yang
#         mengaudit = kode yang diuji di sini. Butuh model verifier (lihat
#         VERIFIER_AGENT_MODEL / VERIFIER_MODEL_PRIMARY); tanpa model audit tetap
#         jalan deterministik dan verdict TIDAK PERNAH dikarang `consistent`.
AGENT_REVIEW_MODE=advisory
AGENT_REVIEW_TIMEOUT_SECONDS=75

# --- SAP (mock / integrasi) ---------------------------------------------------
# mock = layanan tiruan di dalam repo (DEFAULT); aws_mcp = jalur AWS for SAP
# MCP Server (A4). Adapter MCP-nya sudah ada dan teruji; untuk memakainya isi
# SAP_MCP_ENDPOINT + SAP_MCP_TOKEN dari tenant SAP Anda. Tanpa endpoint,
# pemilihan aws_mcp DITOLAK (fail closed) — tidak jatuh diam-diam ke data mock.
SAP_MATERIAL_STOCK_MODE=mock
SAP_PURCHASE_ORDER_MODE=mock
SAP_MATERIAL_DOCUMENT_MODE=mock
SAP_BUSINESS_PARTNER_MODE=mock
SAP_PRODUCT_MASTER_MODE=mock

# --- AWS for SAP MCP Server (A4) ---------------------------------------------
# Provider yang dipakai aplikasi: mock (default) atau aws_mcp.
SAP_PROVIDER=mock
# Endpoint MCP streamable-HTTP milik tenant Anda, mis. https://<host>/mcp
SAP_MCP_ENDPOINT=
# Bearer token untuk endpoint di atas (JANGAN pernah di-commit).
SAP_MCP_TOKEN=
SAP_MCP_TIMEOUT_SECONDS=10
# Operasi tulis (create_purchase_order) hanya aktif bila true DAN lewat approval.
SAP_MCP_ALLOW_WRITE=false
# Nama tool pada tenant; ubah bila server MCP Anda memakai nama lain.
SAP_MCP_TOOL_STOCK=sap_material_stock
SAP_MCP_TOOL_PURCHASE_ORDERS=sap_purchase_orders
SAP_MCP_TOOL_CREATE_PURCHASE_ORDER=sap_create_purchase_order
SAP_MCP_TOOL_BUSINESS_PARTNER=sap_business_partner
SAP_MCP_TOOL_PRODUCT_MASTER=sap_product_master

# --- SAP AI Core (kredensial dari panitia / keybroker) ------------------------
# Nilai asli HANYA di .env lokal. Urutan penamaan: SAP_AI_CORE_* (dipakai
# backend) — jangan tertukar dengan AICORE_* yang dipakai skrip probe.
SAP_AI_CORE_AUTH_URL=https://contoh.authentication.ap10.hana.ondemand.com
SAP_AI_CORE_API_URL=https://contoh.ap10.sapdas.cloud.sap
# Nilai yang memuat karakter khusus (mis. `!`) HARUS dikutip: tanpa kutip, `source .env`
# di bash menganggap `!` sebagai riwayat/ekspansi dan baris gagal dieksekusi.
SAP_AI_CORE_CLIENT_ID='sb-contoh!t000000'
SAP_AI_CORE_CLIENT_SECRET='contoh-rahasia-dengan-$-dan-|'
SAP_AI_CORE_RESOURCE_GROUP=default
SAP_AI_CORE_DEPLOYMENT_ID_LLM=0000000000000000
SAP_AI_CORE_DEPLOYMENT_ID_RPT=0000000000000000

# --- AWS (Bedrock / AgentCore) ------------------------------------------------
AWS_REGION=ap-southeast-2
AWS_PROFILE=
# Kunci asli jangan di berkas ini: taruh di secrets/aws-app.env (diabaikan git)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AGENTCORE_RUNTIME_ARN=
AGENTCORE_GATEWAY_URL=
AGENTCORE_MEMORY_ID=

# --- Klien agent → API MealChain (dipakai DI DALAM AgentCore Runtime) -----------
# Runtime tidak bisa memakai "localhost"; isi URL yang bisa dijangkau dari AWS:
# - docker compose lokal antar-container : http://backend:8000
# - runtime di AWS (AgentCore)           : URL HTTPS publik backend (tunnel tetap
#   seperti cloudflared, atau VPS/domain sendiri). Setelah URL berubah, jalankan
#   `python agent/set_runtime_env.py --api-url <URL>` agar env runtime ikut pindah.
MEALCHAIN_API_URL=http://backend:8000
# Token JWT role bgn_monitor (30 hari) untuk worker membaca API. Buat dengan
# `python backend/scripts/make_agent_token.py` atau endpoint login.
MEALCHAIN_API_TOKEN=

# --- Inferhub (fallback model) ------------------------------------------------
INFERHUB_URL=
INFERHUB_API_KEY=

# --- Rantai model (nama model, bukan rahasia) ---------------------------------
SUPERVISOR_MODEL_PRIMARY=us.anthropic.claude-sonnet-5
SUPERVISOR_MODEL_FALLBACK=
SUPERVISOR_MODEL_FALLBACK_1=
SUPERVISOR_MODEL_FALLBACK_2=
SUPERVISOR_MODEL_FALLBACK_3=
SUPERVISOR_MODEL_FALLBACK_4=
SUPERVISOR_MODEL_FALLBACK_5=
SUPERVISOR_MODEL_FALLBACK_6=
SUPERVISOR_MODEL_FALLBACK_7=
SUPERVISOR_MODEL_FALLBACK_8=
SUPERVISOR_MODEL_FALLBACK_9=
SUPERVISOR_MODEL_FALLBACK_10=
SUPERVISOR_MODEL_FALLBACK_11=

VERIFIER_MODEL_PRIMARY=
VERIFIER_MODEL_FALLBACK_1=
VERIFIER_MODEL_FALLBACK_2=
# Model khusus AGENT VERIFIER pada jalur review `local` (kosong = pakai
# VERIFIER_MODEL_PRIMARY, lalu SUPERVISOR_MODEL_PRIMARY). Bentuk id sama dengan
# rantai di atas (mis. `sap-ai-core:llm`). ARN AgentCore DITOLAK di sini: audit
# tidak boleh memakai runtime/prompt supervisor.
VERIFIER_AGENT_MODEL=
VERIFIER_MODEL_FALLBACK_3=
VERIFIER_MODEL_FALLBACK_4=
VERIFIER_MODEL_FALLBACK_5=
VERIFIER_MODEL_FALLBACK_6=
VERIFIER_MODEL_FALLBACK_7=
VERIFIER_MODEL_FALLBACK_8=
VERIFIER_MODEL_FALLBACK_9=
VERIFIER_MODEL_FALLBACK_10=

FORECAST_MODEL=
FORECAST_MODEL_FALLBACK_1=
FORECAST_MODEL_FALLBACK_2=
FORECAST_MODEL_FALLBACK_3=
FORECAST_MODEL_FALLBACK_4=
FORECAST_MODEL_FALLBACK_5=
FORECAST_MODEL_FALLBACK_6=
FORECAST_MODEL_FALLBACK_7=
FORECAST_MODEL_FALLBACK_8=
FORECAST_MODEL_FALLBACK_9=
FORECAST_MODEL_FALLBACK_10=

# --- Integritas (P3): tanda tangan ECDSA dossier -------------------------------
# 64 hex = kunci privat secp256k1. Kosong = state `unsigned` (jujur, bukan ttd
# palsu). Buat baru: `openssl rand -hex 32`.
SIGNING_KEY_HEX=
