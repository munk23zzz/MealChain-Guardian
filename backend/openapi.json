  "components": {
    "schemas": {
      "ApproveRequest": {
        "properties": {
          "decision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Decision Id"
          },
          "approved": {
            "type": "boolean",
            "title": "Approved"
          },
          "comment": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Comment"
          }
        },
        "type": "object",
        "required": [
          "decision_id",
          "approved"
        ],
        "title": "ApproveRequest"
      },
      "DecisionCreate": {
        "properties": {
          "recommendation": {
            "type": "object",
            "title": "Recommendation"
          },
          "ttl_minutes": {
            "type": "integer",
            "maximum": 1440.0,
            "minimum": 1.0,
            "title": "Ttl Minutes",
            "default": 30
          },
          "decision_type": {
            "type": "string",
            "title": "Decision Type",
            "default": "regional_balance"
          }
        },
        "type": "object",
        "required": [
          "recommendation"
        ],
        "title": "DecisionCreate"
      },
      "DemandResponse": {
        "properties": {
          "quantity_kg": {
            "type": "number",
            "title": "Quantity Kg"
          },
          "needed_by": {
            "type": "string",
            "title": "Needed By"
          }
        },
        "type": "object",
        "required": [
          "quantity_kg",
          "needed_by"
        ],
        "title": "DemandResponse"
      },
      "DeviationRequest": {
        "properties": {
          "location": {
            "type": "string",
            "title": "Location"
          },
          "commodity": {
            "type": "string",
            "title": "Commodity"
          },
          "supplier_price": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Supplier Price"
          }
        },
        "type": "object",
        "required": [
          "location",
          "commodity",
          "supplier_price"
        ],
        "title": "DeviationRequest"
      },
      "ExecuteRequest": {
        "properties": {
          "decision_id": {
            "type": "string",
            "format": "uuid",
            "title": "Decision Id"
          }
        },
        "type": "object",
        "required": [
          "decision_id"
        ],
        "title": "ExecuteRequest"
      },
      "ForecastResponse": {
        "properties": {
          "forecast_qty_kg": {
            "type": "number",
            "title": "Forecast Qty Kg"
          },
          "method": {
            "type": "string",
            "title": "Method"
          },
          "confidence": {
            "type": "number",
            "title": "Confidence"
          }
        },
        "type": "object",
        "required": [
          "forecast_qty_kg",
          "method",
          "confidence"
        ],
        "title": "ForecastResponse"
      },
      "FreshnessRequest": {
        "properties": {
          "batch_id": {
            "type": "string",
            "title": "Batch Id"
