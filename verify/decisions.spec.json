{
  "name": "mealchain-decisions-write-flow",
  "artifact_dir": "verify-out-decisions",
  "log_fail_patterns": [
    "Traceback (most recent call last)",
    "CRITICAL"
  ],
  "services": [
    {
      "name": "mutations stack",
      "cwd": "..",
      "start": "docker compose -p mcg-mut -f verify/docker-compose.mutations.yml up -d --wait",
      "oneshot": true,
      "timeout": 420,
      "port": 18000,
      "port_timeout": 240,
      "health": "http://127.0.0.1:18000/health",
      "health_timeout": 120,
      "health_retries": 12,
      "logs_command": "docker logs mcg-mut-backend-1 --tail 200"
    }
  ],
  "logins": {
    "head_jkt": {
      "as": "SPPG Jakarta head (pengusul + approver 1)",
      "url": "http://127.0.0.1:18000/auth/login",
      "json": {
        "email": "sppg.head@demo.local",
        "password": "Demo#SPPG2026"
      }
    },
    "nut_jkt": {
      "as": "SPPG Jakarta nutritionist (approver 2)",
      "url": "http://127.0.0.1:18000/auth/login",
      "json": {
        "email": "sppg.nutritionist@demo.local",
        "password": "Demo#Nut2026"
      }
    },
    "monitor": {
      "as": "BGN monitor (tidak boleh menyetujui)",
      "url": "http://127.0.0.1:18000/auth/login",
      "json": {
        "email": "bgn.monitor@demo.local",
        "password": "Demo#BGN2026"
      }
    },
    "head_bdg": {
      "as": "SPPG Bandung head (lokasi lain)",
      "url": "http://127.0.0.1:18000/auth/login",
      "json": {
        "email": "sppg.head.bandung@demo.local",
        "password": "Demo#SPPG2026"
      }
    }
  },
  "http": [
    {
      "name": "1. POST /decisions membuat keputusan (proposed)",
      "method": "POST",
      "url": "http://127.0.0.1:18000/decisions",
      "as": "head_jkt",
      "json": {
        "recommendation": {
          "candidate": {
            "source_location": "Cianjur",
            "destination_location": "Jakarta",
            "commodity": "telur",
            "quantity_kg": "600"
          },
          "safe_delivered_cost": "16206000",
          "cost_breakdown": {
            "purchase": "15720000"
          }
        }
      },
      "expect_status": 201,
      "expect_keys": [
        "decision_id",
        "status",
        "valid"
      ],
      "expect_json": {
        "status": "proposed",
        "valid": true
      },
      "extract": "decision_id",
      "store": "did",
      "max_ms": 30000
    },
    {
      "name": "2. GET /decisions/{id} membaca kembali keputusan baru",
      "method": "GET",
      "url": "http://127.0.0.1:18000/decisions/{var:did}",
      "as": "head_jkt",
      "expect_status": 200,
      "expect_json": {
        "status": "proposed"
      },
      "max_ms": 5000
    },
    {
      "name": "3. POST /actions/propose -> pending_approval, wajib 2 approval",
      "method": "POST",
      "url": "http://127.0.0.1:18000/actions/propose",
      "as": "head_jkt",
      "json": {
        "decision_id": "{var:did}",
        "material_number": "MAT-TELUR-JKT"
      },
      "expect_status": 201,
      "expect_json": {
        "status": "pending_approval",
        "verified": false,
        "approval_requirement.min_approvals": 2
      },
      "extract": "approval_requirement.min_approvals",
      "store": "min_approvals",
      "max_ms": 10000
    },
    {
      "name": "4. POST /actions/verify tanpa provider -> UNAVAILABLE, tidak dicatat",
      "method": "POST",
      "url": "http://127.0.0.1:18000/actions/verify",
      "as": "head_jkt",
      "json": {
        "decision_id": "{var:did}"
      },
      "expect_status": 200,
      "expect_json": {
        "verdict": "UNAVAILABLE",
        "recorded": false
      },
      "max_ms": 20000
    },
    {
      "name": "5. execute sebelum ada verdict -> 409 (fail-closed)",
      "method": "POST",
      "url": "http://127.0.0.1:18000/actions/execute",
      "as": "head_jkt",
      "json": {
        "decision_id": "{var:did}"
      },
      "expect_status": [
        409
      ],
      "expect_body_contains": "belum terverifikasi"
    },
    {
      "name": "6. approve sebelum ada verdict -> 409",
      "method": "POST",
      "url": "http://127.0.0.1:18000/actions/approve",
      "as": "head_jkt",
      "json": {
        "decision_id": "{var:did}",
        "approved": true
      },
      "expect_status": [
        409
      ],
      "expect_body_contains": "belum diverifikasi"
    },
    {
      "name": "7. approve dari SPPG lokasi lain -> 403",
      "method": "POST",
      "url": "http://127.0.0.1:18000/actions/approve",
      "as": "head_bdg",
      "json": {
        "decision_id": "{var:did}",
        "approved": true
      },
      "expect_status": [
        403
      ],
      "expect_body_contains": "di luar SPPG"
    },
    {
      "name": "8. approve oleh BGN monitor -> 403",
      "method": "POST",
      "url": "http://127.0.0.1:18000/actions/approve",
      "as": "monitor",
      "json": {
        "decision_id": "{var:did}",
        "approved": true
      },
      "expect_status": [
        403
      ],
      "expect_body_contains": "role tidak diizinkan"
    },
    {
      "name": "9. approve #1 oleh SPPG head -> 200",
      "method": "POST",
      "url": "http://127.0.0.1:18000/actions/approve",
      "as": "head_jkt",
      "json": {
        "decision_id": "{var:did}",
        "approved": true
      },
      "expect_status": 200,
      "extract": "decision_id",
      "store": "approved_once",
      "max_ms": 10000
    },
    {
      "name": "10. execute dengan baru 1 approval -> 409",
      "method": "POST",
      "url": "http://127.0.0.1:18000/actions/execute",
      "as": "head_jkt",
      "json": {
        "decision_id": "{var:did}"
      },
      "expect_status": [
        409
      ]
    },
    {
      "name": "11. approve #2 oleh nutritionist -> 200",
      "method": "POST",
      "url": "http://127.0.0.1:18000/actions/approve",
      "as": "nut_jkt",
      "json": {
        "decision_id": "{var:did}",
        "approved": true
      },
      "expect_status": 200,
      "extract": "decision_id",
      "store": "approved_twice",
      "max_ms": 10000
    },
    {
      "name": "12. execute -> 200, PO mock terbit (MC-...)",
      "method": "POST",
      "url": "http://127.0.0.1:18000/actions/execute",
      "as": "head_jkt",
      "json": {
        "decision_id": "{var:did}"
      },
      "expect_status": 200,
      "expect_keys": [
        "po_number",
        "data_source"
      ],
      "expect_json": {
        "data_source": "MOCK"
      },
      "extract": "po_number",
      "store": "api_po",
      "max_ms": 60000
    },
    {
      "name": "13. execute ulang -> 409 (tidak bisa dieksekusi dua kali)",
      "method": "POST",
      "url": "http://127.0.0.1:18000/actions/execute",
      "as": "head_jkt",
      "json": {
        "decision_id": "{var:did}"
      },
      "expect_status": [
        409
      ]
    },
    {
      "name": "14. audit trail: chain keputusan terbaca",
      "method": "GET",
      "url": "http://127.0.0.1:18000/decisions/{var:did}/chain",
      "as": "head_jkt",
      "expect_status": 200,
      "expect_keys": [
        "anchor_id",
        "chain"
      ],
      "max_ms": 10000
    },
    {
      "name": "15. approval-summary melaporkan status akhir",
      "method": "GET",
      "url": "http://127.0.0.1:18000/decisions/{var:did}/approval-summary",
      "as": "head_jkt",
      "expect_status": 200,
      "expect_keys": [
        "decision_id",
        "status"
      ],
      "max_ms": 10000
    }
  ],
  "sql_steps": [
    {
      "name": "ikat allocation_binding ke batch Cianjur/telur",
      "after": "3. POST /actions/propose -> pending_approval, wajib 2 approval",
      "sql": "INSERT INTO decision_evidence (decision_id, evidence_type, payload) SELECT '{var:did}', 'human_inspection', jsonb_build_object('allocation_binding', true, 'supplier_id', b.supplier_id::text, 'batch_ids', jsonb_build_array(b.id::text)) FROM batches b JOIN commodities c ON c.id = b.commodity_id JOIN locations l ON l.id = b.location_id WHERE c.name = 'telur' AND l.name = 'Cianjur' AND b.origin = 'seed' ORDER BY b.id LIMIT 1"
    },
    {
      "name": "catat verdict verifier (setara fixture test resmi; produksi butuh provider)",
      "after": "6. approve sebelum ada verdict -> 409",
      "sql": "UPDATE decisions SET verified_by = 'gate-verifier-fixture', verifier_note = 'consistent' WHERE id = '{var:did}'"
    }
  ],
  "db": {
    "kind": "command",
    "target": "postgres:18000/mealchain (stack terisolasi mcg-mut)",
    "run": "docker exec mcg-mut-postgres-1 psql -U mealchain -d mealchain -At -F \"|\" -c \"{sql}\"",
    "checks": [
      {
        "name": "status keputusan akhir = executed",
        "sql": "SELECT status FROM decisions WHERE id = '{var:did}'",
        "expect": "executed"
      },
      {
        "name": "dua approval tercatat (head + nutritionist)",
        "sql": "SELECT count(*) FROM approvals WHERE decision_id = '{var:did}'",
        "expect": 2
      },
      {
        "name": "PO mock tertulis submitted",
        "sql": "SELECT status FROM sap_mock_purchase_orders WHERE decision_id = '{var:did}'",
        "expect": "submitted",
        "store": "db_po_status"
      },
      {
        "name": "nomor PO di DB",
        "sql": "SELECT po_number FROM sap_mock_purchase_orders WHERE decision_id = '{var:did}'",
        "store": "db_po_number",
        "expect_rows": 1
      },
      {
        "name": "hanya satu PO per keputusan",
        "sql": "SELECT count(*) FROM sap_mock_purchase_orders WHERE decision_id = '{var:did}'",
        "expect": 1
      }
    ]
  },
  "compare": [
    {
      "name": "nomor PO: respons API == baris DB",
      "left": "api_po",
      "right": "db_po_number"
    }
  ]
}
