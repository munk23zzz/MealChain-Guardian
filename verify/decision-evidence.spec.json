        "store": "db_target_F1"
      },
      {
        "name": "premis F2: jenis + tidak ada lokasi sumber NULL untuk pengadaan ini",
        "sql": "SELECT decision_type FROM decisions WHERE id = '{var:api_did_F2}'",
        "expect": "supplier_procurement"
      },
      {
