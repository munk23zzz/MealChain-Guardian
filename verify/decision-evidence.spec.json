      {
        "name": "premis kontrol negatif: keputusan uji 403 memang ber-target Bandung",
        "sql": "SELECT l.name FROM decisions d JOIN locations l ON l.id = d.target_location_id WHERE d.id = '{var:api_did_neg}'",
        "expect": "Bandung"
      },
      {
        "name": "invarian: tidak ada keputusan pending tanpa pengusul",
        "sql": "SELECT count(*) FROM decisions WHERE status = 'pending_approval' AND proposed_by IS NULL",
        "expect": 0
      }
    ]
