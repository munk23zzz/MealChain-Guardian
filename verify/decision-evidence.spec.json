        "expect": 600,
        "store": "db_qty_F2"
      },
      {
        "name": "F2 safe_delivered_cost di DB (dibandingkan ke API)",
        "sql": "SELECT safe_delivered_cost FROM decisions WHERE id = '{var:api_did_F2}'",
        "expect": 24719375.7,
        "store": "db_sdc_F2"
      },
      {
        "name": "F2 iterasi di DB (dibandingkan ke jumlah langkah chain API)",
        "sql": "SELECT iteration FROM decisions WHERE id = '{var:api_did_F2}'",
        "expect": 1,
        "store": "db_iter_F2"
      },
      {
