{
  "name": "mealchain-decision-evidence-readonly",
  "artifact_dir": "verify-out-evidence",
  "_comment": "GATE READ-ONLY untuk halaman sidebar 'Decision & Evidence' (frontend/app/page.tsx tab id 'evidence', komponen components/DecisionEvidence.tsx dkk). Stack demo SUDAH hidup: semua service external:true (gate tidak pernah start/stop container), DB dibaca lewat `docker exec mealchain-postgres psql` dan TIDAK ada satu pun tulis ke DB. Satu-satunya POST adalah /auth/login. Fixture keputusan dipilih dari baris SEED deterministik (UUID v5 hasil app/seed/demo_template.py, mis. 2ae7e0f9-...-5baf) supaya tidak hilang saat demo dibangun ulang, plus satu keputusan supplier_procurement ber-source_location_id NULL (6911bddf-...) yang memang dibuat lewat POST /decisions oleh sesi lain - premise-nya diverifikasi eksplisit oleh cek DB, jadi kalau baris itu dipurge gate gagal dengan nama fixture, bukan diam-diam lolos. Status TIDAK dipatok untuk keputusan non-terminal (bisa berubah oleh sesi lain di stack demo); yang dipatok adalah field imutabel (decision_type, target_location, quantity_kg, iteration, source_location null) dan status hanya untuk baris terminal (executed).",
  "log_fail_patterns": [
    "Traceback (most recent call last)",
    "CRITICAL",
    "Unhandled exception"
  ],
  "services": [
    {
      "name": "postgres",
      "external": true,
      "port": 15432,
      "timeout": 20
    },
    {
      "name": "backend",
      "external": true,
      "port": 8000,
      "health": "http://127.0.0.1:8000/health",
      "health_timeout": 20,
      "health_retries": 3,
      "logs_command": "docker logs mealchain-backend --tail 400",
      "log_fail_patterns": [
        "Traceback (most recent call last)",
        "CRITICAL",
        "Unhandled exception"
      ]
    },
    {
      "name": "frontend",
      "external": true,
      "port": 3010,
      "health": "http://127.0.0.1:3010/",
      "health_timeout": 60,
      "health_retries": 4,
      "logs_command": "docker logs mealchain-frontend --tail 300",
      "log_fail_patterns": [
        "Unhandled Runtime Error",
        "Module not found",
        "ENOENT"
      ]
    },
    {
      "name": "mock-sap",
      "external": true,
      "port": 8001,
      "timeout": 20,
      "logs_command": "docker logs mealchain-mock-sap --tail 200"
    }
  ],
  "containers": [
    "mealchain-backend",
    "mealchain-frontend",
    "mealchain-postgres",
    "mealchain-mock-sap"
  ],
