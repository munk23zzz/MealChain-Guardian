    "checks": [
      {
        "name": "akun kepala SPPG Jakarta ada di tabel users (dipakai login head_jkt)",
        "sql": "SELECT count(*) FROM users WHERE email = 'sppg.head@demo.local' AND role = 'sppg_head' AND location_id = '275d1be7-5bb8-5a37-8004-a2d40a51eb7e'",
        "expect": 1
      },
      {
        "name": "akun ahli gizi Jakarta ada di tabel users (dipakai login nut_jkt)",
        "sql": "SELECT count(*) FROM users WHERE email = 'sppg.nutritionist@demo.local' AND role = 'sppg_nutritionist' AND location_id = '275d1be7-5bb8-5a37-8004-a2d40a51eb7e'",
        "expect": 1
      },
      {
        "name": "akun BGN monitor ada di tabel users, tanpa lokasi (dipakai login monitor)",
        "sql": "SELECT count(*) FROM users WHERE email = 'bgn.monitor@demo.local' AND role = 'bgn_monitor' AND location_id IS NULL",
        "expect": 1
      },
      {
        "name": "premis F1: jenis keputusan di DB",
        "sql": "SELECT decision_type FROM decisions WHERE id = '{var:api_did_F1}'",
        "expect": "supplier_exclusion_restoration"
      },
      {
