{
  "version": 1,
  "mode": "advisory",
  "agents": [
    {
      "name": "supply",
      "role": "Supply Agent",
      "stage": "DETECT",
      "blocking_allowed": false,
      "description": "Membaca pasokan, surplus, dan kekurangan dari API.",
      "endpoints": [
        "GET /supply/{location}/{commodity}",
        "GET /balance/{location}/{commodity}"
      ]
    },
    {
      "name": "demand",
      "role": "Demand Agent",
      "stage": "PREDICT",
      "blocking_allowed": false,
      "description": "Membaca permintaan, agenda, dan forecast dari API.",
      "endpoints": [
        "GET /demand/{location}/{commodity}",
        "GET /demand/forecast/{location}/{commodity}",
        "GET /agenda"
      ]
    },
    {
      "name": "freshness",
      "role": "Freshness Guardian",
      "stage": "VERIFY",
      "blocking_allowed": true,
      "description": "Memeriksa kesegaran batch dan risiko kedaluwarsa.",
      "endpoints": [
        "GET /batches"
      ]
    },
    {
      "name": "safety",
      "role": "Safety Guardian",
      "stage": "VERIFY",
      "blocking_allowed": true,
      "description": "Memeriksa status keamanan batch dan exclusion pemasok.",
      "endpoints": [
        "GET /batches",
        "GET /supplier-exclusions",
        "GET /supplier-exclusions/context/{decision_id}"
      ]
    },
    {
      "name": "price",
      "role": "Price Agent",
      "stage": "OPTIMIZE",
      "blocking_allowed": false,
      "description": "Membaca quote, referensi harga, deviasi, dan SDC.",
      "endpoints": [
        "GET /price/{location}/{commodity}",
        "GET /price/quotes/{location}/{commodity}",
        "POST /price/deviation",
        "POST /cost/safe-delivered"
      ]
    },
    {
      "name": "logistics",
      "role": "Logistics Agent",
      "stage": "OPTIMIZE",
      "blocking_allowed": false,
      "description": "Membaca jarak, durasi, kelayakan rute, dan rute pemasok.",
      "endpoints": [
        "POST /logistics/estimate",
        "GET /supplier-routes"
      ]
    },
    {
      "name": "evidence",
      "role": "Evidence Fusion Agent",
      "stage": "TRACE",
      "blocking_allowed": true,
      "description": "Membaca dossier, chain, compliance, trace, dan ledger.",
      "endpoints": [
        "GET /decisions/{decision_id}/dossier",
        "GET /decisions/{decision_id}/chain",
        "GET /decisions/{decision_id}/compliance",
        "GET /decisions/{decision_id}/traces",
        "GET /ledger/verify",
        "POST /evidence/fuse"
      ]
    }
  ],
  "lanes": [
    ["supply", "demand"],
    ["safety", "freshness"],
    ["price", "logistics"]
  ]
}
